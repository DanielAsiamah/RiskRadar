# Expo frontend
EXPO_PUBLIC_API_BASE_URL=https://your-backend-domain.onrender.com
EXPO_PUBLIC_API_PORT=3001
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
EXPO_PUBLIC_WEB_APP_URL=https://your-frontend-domain.example
# Legacy projects may use EXPO_PUBLIC_SUPABASE_ANON_KEY instead. Never put an
# sb_secret or service_role value in an EXPO_PUBLIC variable.

# Serve an exported Expo web app from the same backend process
WEB_APP_ENABLED=true
WEB_DIST_DIR=./dist
# Comma-separated websites allowed to iframe /embed; same-origin is always allowed.
EMBED_ALLOW_ORIGINS=https://your-website.example

# Backend runtime
HOST=0.0.0.0
PORT=3001
NODE_ENV=production
RISKRADAR_DATA_DIR=./backend/cache
SHUTDOWN_TIMEOUT_MS=10000
STATE_DRIVER=json
SQLITE_STATE_FILE=./backend/cache/riskradar-state.sqlite
SQLITE_BOOTSTRAP_FROM_JSON=true
ADMIN_API_KEY=change-me-before-using-admin-endpoints
MAX_REQUEST_BODY_BYTES=32768
ADMIN_MAX_REQUEST_BODY_BYTES=2097152

# CORS and public traffic protection
CORS_ALLOW_ORIGIN=https://your-frontend-domain.example
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=180

# Upstream resilience
UPSTREAM_TIMEOUT_MS=15000
UPSTREAM_RETRY_COUNT=1
UPSTREAM_RETRY_DELAY_MS=350
MONTHLY_FETCH_CONCURRENCY=2
STALE_IF_ERROR_ENABLED=true
STALE_CACHE_MAX_AGE_MS=604800000

# Cache and persistence
CACHE_TTL_MS=900000
GEOCODE_CACHE_TTL_MS=86400000
CRIME_CACHE_TTL_MS=21600000
CACHE_MAX_ENTRIES=500
PERSISTENT_CACHE_ENABLED=true
ANALYSIS_SNAPSHOTS_ENABLED=true
ANALYSIS_CACHE_ENABLED=true
SEARCH_PRESETS_ENABLED=true

# Optional local crime snapshot mode
CRIME_SOURCE_MODE=api
CRIME_SOURCE_FALLBACK_TO_API=true
CRIME_DATA_ROOT=./backend/data/police
ROUTE_PROVIDER=mock

# Free official Environment Agency flood monitoring. This is enabled by default
# and stores its live history in memory until a persistent store is configured.
LIVE_INGESTION_AUTOSTART=true
# Optional operator-only manual poll credential. Use at least 32 random characters.
LIVE_INGESTION_SECRET=replace-me-with-at-least-32-random-characters

# Premium membership backend. These values are read only by backend/server.mjs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-me
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_PREMIUM_PRICE_ID=price_replace-me
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/replace-me
BILLING_REFERENCE_SECRET=replace-me-with-at-least-32-random-characters
WEB_APP_URL=https://your-frontend-domain.example
